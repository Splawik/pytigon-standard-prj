# Project environment files live next to each Django project as `env` or
# `.env`. This is a template — copy it to a project and fill it in. Never
# commit a real file with secrets.
#
# SECRET_KEY is intentionally NOT shipped: if unset, a key is generated per
# installation; a production deployment must set it explicitly.

SECRET_KEY=
DEBUG=
# PWA=True
# DJANGO_Q=True
# GRAPHQL=true
# REST=true
# ALLAUTH=true
